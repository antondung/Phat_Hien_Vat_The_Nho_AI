# Bộ phát hiện: mock (dùng nhãn gốc của dataset) | yolo (model thật)
DETECTOR=mock
DET_MODEL=weights/det_best.pt
POSE_MODEL=weights/pose_best.pt
DET_CONF=0.25
DET_IOU=0.45
CLASS_CONF=phone:0.25,paper:0.5,calculator:0.5
IMG_SIZE=960
DEVICE=
DATASET_DIR=/workspace/dataset/ds
JWT_SECRET=doi-chuoi-bi-mat-nay-dai-it-nhat-32-ky-tu
DETECT_FPS=5
AUTOSTART_CAMERAS=1
CORS_ORIGINS=http://localhost:5173

# Không seed camera/cảnh báo mẫu khi DB trống (mặc định). Đặt 1 để có 8 camera dataset.
SEED_DEMO=0
# off: không khởi động camera nguồn dataset:// còn trong DB
SAMPLE_CAMERAS=off

# Máy yếu (tuỳ chọn): yolo26n + imgsz 480 + pose cách 1 khung. Mặc định s/640 nhận điện thoại tốt hơn.
# DET_MODEL=weights/yolo26n.pt
# POSE_MODEL=weights/yolo26n-pose.pt
# IMG_SIZE=480
# POSE_EVERY_N=2

# ---- Giám thị / thí sinh (model vai trò YOLO26m TSII: student/teacher) ----
# Chép best.pt của anh Dũng thành weights/role_best.pt rồi khởi động lại BE.
# Thiếu file hoặc lỗi load: BE chỉ cảnh báo và chạy tiếp (role:'unknown'). Để trống = tắt.
# ROLE_MODEL=weights/role_best.pt
# ROLE_CLASSES=invigilator:teacher|giám thị|invigilator;student:student|thí sinh|sinh viên
# ROLE_CONF=0.35
# ROLE_IMG_SIZE=480        # model train 640; 480 nhanh hơn ~35% trên CPU
# ROLE_EVERY_N=3           # chạy model vai trò mỗi 3 khung phân tích (vai trò ít đổi, đã làm mượt 5 lần)
# ROLE_ADAPTIVE=1          # CPU chậm thì tự giãn N (tối đa ROLE_MAX_EVERY_N=10)
# ROLE_ONLY_CONF=0.7       # box vai trò không khớp người DET chỉ thành "người" khi conf >= 0.7, đủ 2 lần, không ôm mép
# ROOM_NO_INVIGILATOR_SEC=120   # Thông tin "không thấy giám thị trong phòng"; 0 = tắt
# Máy yếu: ROLE_IMG_SIZE=416, ROLE_EVERY_N=5 (hoặc ROLE_MODEL= để tắt hẳn), kèm profile yolo26n ở trên.

# ---- Điện thoại nhỏ / bị che / dưới gầm bàn (lượt 2 phóng tay/bàn) ----
# Mặc định bật. Máy yếu: PHONE_ZOOM_EVERY_N=4 hoặc PHONE_ZOOM=0.
# PHONE_CONF=0.25
# PHONE_ZOOM=1
# PHONE_ZOOM_CONF=0.20
# PHONE_ZOOM_IMG_SIZE=416
# PHONE_ZOOM_EVERY_N=2
# PHONE_ZOOM_MAX_CROPS=12
# PHONE_IMAGE_CONF=0.35
# PHONE_ZOOM_MIN_CROP=160
# PHONE_ZOOM_FAR_TILE=1
# PHONE_ZOOM_TILE_SIZE=256
