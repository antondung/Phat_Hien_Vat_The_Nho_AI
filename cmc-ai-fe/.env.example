# Chế độ dữ liệu: real = backend CMC AI thật (mặc định, npm run dev) ; mock = giả lập (npm run dev:mock)
VITE_API_MODE=real

# --- Chỉ dùng khi VITE_API_MODE=real ---
# Để trống / đường dẫn tương đối = đi qua proxy của Vite (khuyến nghị, không vướng CORS):
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
# Hoặc gọi thẳng backend (cần CORS mở cho origin của FE):
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/ws

# Đích của proxy /api, /ws, /media trong `npm run dev` và `npm run preview` (không lộ ra trình duyệt)
BACKEND_URL=http://localhost:8000

# Gốc HTTPS in trên mã QR (`npm run dev:phone` tự điền). Ghi đè bằng LAN_IP / PHONE_HOST.
# VITE_PHONE_LAN_HOST=https://192.168.1.20:5173
